# vim: ft=sh: set et ts=2 sw=2:

alias blaze=bazel
alias ls='eza'
alias cat='bat'
alias j='jj'
alias tmux='tmx2 new-session -A -s main'
alias l='ls -alF --color-scale --icons --group-directories-first'
alias :e='nvim'
alias :q='exit'
alias please='sudo $(fc -ln -1)'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias .......='cd ../../../../../..'

palette() {
  local -a colors
  for i in {000..255}; do
    colors+=("%F{$i}$i%f")
  done
  print -cP $colors
}
